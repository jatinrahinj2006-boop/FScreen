{
  "manifest_version": 3,
  "name": "FScreen",
  "version": "1.4.0",
  "description": "Pane-relative fullscreen on demand: Alt+` expands the player to fill only the tab viewport, so split-screen stays intact. The site's own fullscreen (F key, fullscreen button) stays real unless you opt in with the toolbar icon.",
  "minimum_chrome_version": "111",

  "permissions": ["activeTab", "storage"],

  "host_permissions": [
    "*://*.youtube.com/*",
    "*://anikototv.to/*",
    "*://*.anikototv.to/*",
    "*://megaplay.buzz/*",
    "*://*.megaplay.buzz/*",
    "*://cinehd.vc/*",
    "*://*.cinehd.vc/*",
    "*://vthd.org/*",
    "*://*.vthd.org/*",
    "*://hianime.at/*",
    "*://*.hianime.at/*",
    "*://zokoanime.video/*",
    "*://*.zokoanime.video/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_title": "FScreen 1.4.0: send this site's fullscreen to the pane (badge shows ON/OFF)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://anikototv.to/*",
        "*://*.anikototv.to/*",
        "*://megaplay.buzz/*",
        "*://*.megaplay.buzz/*",
        "*://cinehd.vc/*",
        "*://*.cinehd.vc/*",
        "*://vthd.org/*",
        "*://*.vthd.org/*",
        "*://hianime.at/*",
        "*://*.hianime.at/*",
        "*://zokoanime.video/*",
        "*://*.zokoanime.video/*"
      ],
      "js": ["src/content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://anikototv.to/*",
        "*://*.anikototv.to/*",
        "*://megaplay.buzz/*",
        "*://*.megaplay.buzz/*",
        "*://cinehd.vc/*",
        "*://*.cinehd.vc/*",
        "*://vthd.org/*",
        "*://*.vthd.org/*",
        "*://hianime.at/*",
        "*://*.hianime.at/*",
        "*://zokoanime.video/*",
        "*://*.zokoanime.video/*"
      ],
      "js": ["src/content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],

  "commands": {
    "toggle": {
      "description": "Toggle FScreen pane-fullscreen in the active tab (Alt+` works in-page; bind Alt+` here at chrome://extensions/shortcuts to have Chrome deliver it even when focus is inside an embed)."
    }
  }
}
